{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "ember-evaluator": ["./src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "plugins/**/*.ts", "tests/**/*.ts", "vitest*.config.ts"],
  "exclude": ["node_modules", "dist", "plugins/*/dist", "plugins/*/node_modules"]
}
